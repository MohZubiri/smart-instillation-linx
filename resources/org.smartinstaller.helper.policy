<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Smart Package Installer</vendor>
  <vendor_url>https://github.com/smart-installer</vendor_url>

  <action id="org.smartinstaller.helper">
    <description>Run Smart Package Installer Privileged Helper</description>
    <message>Authentication is required to install or manage system packages</message>
    <message xml:lang="ar">مطلوب التحقق من الصلاحيات لتثبيت البرامج أو إدارتها على مستوى النظام</message>
    <icon_name>smart-installer</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/python3</annotate>
    <annotate key="org.freedesktop.policykit.exec.argv1">/opt/smart-installer/privileged_helper.py</annotate>
  </action>
</policyconfig>

